{
  "name": "wxapp-runner",
  "version": "0.2.0",
  "private": true,
  "description": "WeChat mini-program runtime (Electron)",
  "author": "WxappRunner contributors",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dist:win": "node scripts/prepare-win-native.mjs && npm run build && electron-builder --win nsis --x64",
    "start": "npm run build && electron .",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "check": "node scripts/check.mjs",
    "check:loader": "node scripts/check.mjs --loader",
    "smoke:exparser": "npm run build && node scripts/smoke-exparser.mjs",
    "inspect": "node --import tsx src/inspect.ts",
    "smoke:failures": "npm run build && node scripts/smoke-failures.mjs",
    "smoke:native-devtools": "npm run build && node scripts/smoke-native-devtools.mjs",
    "mcp": "node dist/mcp.cjs",
    "smoke:mcp": "npm run build && node scripts/smoke-mcp.mjs",
    "smoke:interactions": "npm run build && node scripts/smoke-interactions.mjs",
    "smoke:routes": "npm run build && node scripts/smoke-routes.mjs",
    "smoke:loader": "npm run build && node scripts/smoke-loader-dependencies.mjs",
    "smoke:renderer": "npm run build && node scripts/smoke-renderer-fallback.mjs",
    "smoke:official-demo": "npm run build && node scripts/smoke-official-demo.mjs",
    "smoke:location": "npm run build && node scripts/smoke-location.mjs",
    "smoke:location-simulation": "npm run build && node scripts/smoke-location-simulation.mjs",
    "smoke:package": "npm run build && node scripts/smoke-package-loader.mjs",
    "smoke:debug": "npm run build && node scripts/smoke-controller.mjs && node scripts/smoke-wxapp-panel.mjs",
    "smoke:login": "node --import tsx scripts/smoke-login.ts",
    "catalog": "node --import tsx scripts/catalog.ts",
    "smoke:suite": "npm run build && node scripts/smoke-suite-all.mjs",
    "smoke:device": "npm run build && node scripts/smoke-device-suite.mjs",
    "smoke:video": "npm run build && node --import tsx scripts/smoke-native-video.mjs",
    "smoke:cloud": "npm run build && node scripts/smoke-cloud.mjs",
    "smoke:cloud-jobs": "npm run build && node scripts/smoke-cloud-jobs.mjs",
    "smoke:camera-map": "npm run build && node scripts/smoke-camera-map.mjs",
    "packages": "node dist/packages.cjs",
    "smoke:packages": "npm run build && node scripts/smoke-packages.mjs",
    "smoke:analysis": "npm run build && node scripts/smoke-analysis.mjs",
    "smoke:boot-analysis": "npm run build && node scripts/smoke-boot-analysis.mjs",
    "smoke:execution": "npm run build && node scripts/smoke-execution.mjs",
    "smoke:analysis-review": "npm run build && node scripts/smoke-analysis-review.mjs",
    "smoke:analysis-workflow": "npm run build && node scripts/smoke-analysis-workflow.mjs",
    "smoke:boot-intrinsics": "npm run build && node --import tsx scripts/smoke-boot-intrinsics.ts && node scripts/smoke-boot-failure.mjs",
    "audit:native": "node --import tsx scripts/audit-native.ts",
    "test:contract": "node --import tsx scripts/run-contract.ts",
    "test:public": "node --import tsx --test tests/controller.test.ts tests/gateway-url.test.ts tests/redact.test.ts tests/replay-headers.test.ts tests/public-source.test.ts",
    "scan:public": "node scripts/check-public-source.mjs",
    "scan:secrets": "gitleaks git --config .gitleaks.toml --redact=100 --ignore-gitleaks-allow --no-banner"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.21",
    "@types/node": "^22.0.0",
    "@types/pngjs": "6.0.5",
    "@types/ws": "8.18.1",
    "aes-js": "3.1.2",
    "crypto-js": "^4.1.1",
    "electron": "40.10.6",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "glass-easel-template-compiler": "1.2.0",
    "js-sha256": "0.11.1",
    "jsencrypt": "3.3.2",
    "node-forge": "1.3.1",
    "playwright": "^1.58.0",
    "prettier": "^3.0.0",
    "sm-crypto": "^0.5.7",
    "tsx": "^4.19.0",
    "tweetnacl": "1.0.3",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@babel/generator": "7.29.8",
    "@babel/parser": "7.29.8",
    "@babel/traverse": "7.29.8",
    "@babel/types": "7.29.8",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@napi-rs/canvas": "1.0.9",
    "@zxing/browser": "0.1.5",
    "acorn": "^8.18.0",
    "gcoord": "1.0.7",
    "leaflet": "1.9.4",
    "pngjs": "7.0.0",
    "undici": "8.10.0",
    "ws": "8.21.3",
    "zod": "^4.6.1"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/lichaohuai/wxapp-runner.git"
  },
  "homepage": "https://github.com/lichaohuai/wxapp-runner#readme",
  "bugs": {
    "url": "https://github.com/lichaohuai/wxapp-runner/issues"
  }
}
